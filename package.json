{
  "name": "mv-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "postbuild": "node scripts/generate-seo.js",
    "preview": "vite preview --host 0.0.0.0",
    "db:setup:local": "wrangler d1 execute mv-studio --local --file=cloudflare/schema.sql",
    "db:setup:remote": "wrangler d1 execute mv-studio --remote --file=cloudflare/schema.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.7",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true
  }
}
