{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mv-studio",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml", "/media/*", "/projects/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mv-studio",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "mv-studio-media", "preview_bucket_name": "mv-studio-media-local" }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
