# Server-only secrets. Copy to supabase/.env.local; never use VITE_ prefixes here.
ALLOWED_ORIGIN=https://mv-aistudio.vercel.app,http://localhost:5173,http://127.0.0.1:5173
GMAIL_SMTP_USER=your-gmail-account@gmail.com
GMAIL_SMTP_APP_PASSWORD=use-a-google-app-password-here
GMAIL_FROM_NAME=MV Studio
ENQUIRY_TO_EMAIL=your-team@example.com
RATE_LIMIT_SALT=replace-with-a-long-random-value
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAMES=mv-aistudio.vercel.app
CHATBOT_HOURLY_REQUESTS=60
CHATBOT_DAILY_AI_CALLS=200
CHATBOT_MAX_ANSWER_TOKENS=400
# Optional. Remove these entries for default keyword / approved-excerpt mode.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_CHAT_MODEL=
